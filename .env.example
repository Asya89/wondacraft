# PostgreSQL connection string
# Local (Docker): postgresql://wondacraft:wondacraft@localhost:5432/wondacraft
# Production (Neon): use the connection string from Neon dashboard
DATABASE_URL="postgresql://wondacraft:wondacraft@localhost:5432/wondacraft"

# Public site URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://wondacraft.am
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin credentials used during database seed (change in production!)
ADMIN_EMAIL="admin@wondacraft.am"
ADMIN_PASSWORD="change-me-in-production"

# Session secret for admin JWT cookies (min 32 characters, use a strong random value in production)
SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

# Image storage provider: "local" for development, "s3" for production cloud storage
STORAGE_PROVIDER="local"

# Cloud storage settings (required when STORAGE_PROVIDER=s3)
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Optional: public base URL for uploaded images in production
STORAGE_PUBLIC_URL=""

# Optional: Telegram notifications (future feature, not required for MVP)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
