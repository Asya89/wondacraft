# Pull production env from Vercel (includes Neon DATABASE_URL):
#   vercel link && vercel env pull .env.local
#
# Or copy DATABASE_URL from Vercel → Project → Settings → Environment Variables

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

ADMIN_EMAIL="admin@wondacraft.am"
ADMIN_PASSWORD="change-me-in-production"

SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

STORAGE_PROVIDER="local"
# Site images: keep in git (_assets/ → public/images/). Do not rely on Vercel uploads.
# Later (if needed): Cloudflare R2 + STORAGE_PROVIDER=s3

STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
